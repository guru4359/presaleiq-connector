<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

  <!-- Auto-poll pending PresaleIQ analyses on CRM Opportunities every 2 min -->
  <record id="ir_cron_presaleiq_auto_poll_crm" model="ir.cron">
    <field name="name">PresaleIQ: Auto-poll pending analyses (CRM Leads)</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="state">code</field>
    <field name="code">model.cron_presaleiq_auto_poll()</field>
    <field name="interval_number">2</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="active" eval="True"/>
  </record>

  <!-- Auto-poll pending PresaleIQ analyses on Sales Orders every 2 min -->
  <record id="ir_cron_presaleiq_auto_poll_sale" model="ir.cron">
    <field name="name">PresaleIQ: Auto-poll pending analyses (Sales Orders)</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">model.cron_presaleiq_auto_poll()</field>
    <field name="interval_number">2</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="active" eval="True"/>
  </record>

</odoo>
