<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="presaleiq_live_agent_wizard_view_form" model="ir.ui.view">
    <field name="name">presaleiq.live.agent.wizard.form</field>
    <field name="model">presaleiq.live.agent.wizard</field>
    <field name="arch" type="xml">
      <form string="Start PresaleIQ Live Agent">
        <sheet>
          <div class="oe_title mb-3">
            <h2>
              <i class="fa fa-robot me-2" style="color:#042C53;"/>
              Start Live Agent — <field name="lead_id" readonly="1" nolabel="1"/>
            </h2>
          </div>
          <group>
            <field name="meeting_url"
                   placeholder="https://zoom.us/j/... or https://teams.microsoft.com/..."
                   autofocus="autofocus"/>
            <field name="agent_name"/>
            <field name="session_mode"/>
          </group>
          <div class="alert alert-info mt-2" role="alert">
            <i class="fa fa-info-circle me-1"/>
            The AI agent joins the meeting silently under the agent name above.
            Open the <strong>battle card dashboard</strong> on a second screen
            or phone to see real-time insights during the call.
          </div>
        </sheet>
        <footer>
          <button name="action_start"
                  type="object"
                  string="Start Agent"
                  class="btn-primary"
                  icon="fa-play"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
