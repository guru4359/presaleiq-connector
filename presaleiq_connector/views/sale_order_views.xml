<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Sales Order form: action buttons + smart button ────────────────── -->
  <record id="sale_order_view_form_presaleiq" model="ir.ui.view">
    <field name="name">sale.order.view.form.presaleiq</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <!-- Smart buttons (top-right pill area) -->
      <div name="button_box" position="inside">
        <button name="action_open_presaleiq"
                type="object"
                class="oe_stat_button"
                icon="fa-robot">
          <div class="o_stat_info">
            <span class="o_stat_text">PresaleIQ</span>
            <span class="o_stat_value">
              <field name="presaleiq_story_count"/> stories
            </span>
          </div>
        </button>
      </div>

      <!-- Primary action buttons -->
      <header position="inside">
        <button name="action_analyze_with_presaleiq"
                type="object"
                string="Analyze with PresaleIQ"
                class="btn btn-primary"
                icon="fa-magic"/>
        <button name="action_license_sizing_presaleiq"
                type="object"
                string="License Sizing"
                class="btn btn-secondary"
                icon="fa-calculator"/>
      </header>

    </field>
  </record>

  <!-- ── PresaleIQ tab in Sales Order form ──────────────────────────────── -->
  <record id="sale_order_view_form_presaleiq_tab" model="ir.ui.view">
    <field name="name">sale.order.view.form.presaleiq.tab</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page name="presaleiq" string="PresaleIQ">

          <!-- Hidden fields needed for invisible modifiers in Odoo 17 -->
          <field name="presaleiq_analysis_id"         invisible="1"/>
          <field name="presaleiq_license_analysis_id" invisible="1"/>

          <!-- Platform selector -->
          <group string="Platform">
            <field name="presaleiq_platform"
                   widget="selection"
                   placeholder="Use global default (set in Settings → PresaleIQ)"
                   help="Platform being sold. Overrides the global setting for this order only. Affects questionnaire, SOW prompts, and licence sizing."/>
          </group>

          <!-- Transcript Upload -->
          <group string="Discovery Transcript">
            <field name="presaleiq_transcript_file"
                   filename="presaleiq_transcript_filename"
                   widget="binary"
                   help="Upload your discovery call transcript (.txt, .docx, or .pdf). Used as input for all PresaleIQ analyses."/>
            <field name="presaleiq_transcript_filename" invisible="1"/>
          </group>

          <!-- AI Analysis section -->
          <group string="AI Analysis — SOW + User Stories">
            <field name="presaleiq_last_analyzed" readonly="1"/>
            <field name="presaleiq_story_count"   readonly="1"/>
            <field name="presaleiq_status"         readonly="1"/>
            <field name="presaleiq_analysis_url"   widget="url" readonly="1"/>
          </group>
          <div class="mt-2 mb-3" invisible="presaleiq_analysis_id == 0">
            <button name="action_refresh_presaleiq_status"
                    type="object"
                    string="Refresh Status"
                    class="btn btn-secondary btn-sm"
                    icon="fa-refresh"/>
          </div>

          <!-- License Sizing section — always visible -->
          <group string="License Sizing">
            <div colspan="2" class="mb-2">
              <button name="action_get_questionnaire"
                      type="object"
                      string="Get Questionnaire"
                      class="btn btn-secondary btn-sm"
                      icon="fa-download"
                      title="Download blank licence-sizing questionnaire to send to your customer"/>
              <button name="action_license_sizing_presaleiq"
                      type="object"
                      string="Run License Sizing"
                      class="btn btn-primary btn-sm ms-2"
                      icon="fa-calculator"
                      title="Run licence sizing from attached filled questionnaire, or open the web form"/>
              <button name="action_refresh_license_sizing_status"
                      type="object"
                      string="Refresh Sizing Status"
                      class="btn btn-secondary btn-sm ms-2"
                      icon="fa-refresh"
                      invisible="presaleiq_license_analysis_id == 0"
                      title="Check latest licence sizing status and download documents if ready"/>
            </div>
            <div colspan="2" class="text-muted small mb-1"
                 invisible="presaleiq_license_analysis_id != 0">
              No filled questionnaire attached yet — click <strong>Get Questionnaire</strong>
              to download the blank form, send to your customer, then attach their completed
              version here and click <strong>Run License Sizing</strong>.
            </div>
            <field name="presaleiq_license_status" readonly="1"
                   invisible="presaleiq_license_analysis_id == 0"/>
            <field name="presaleiq_license_url"    widget="url" readonly="1"
                   invisible="presaleiq_license_analysis_id == 0"/>
          </group>

          <!-- Last Push section -->
          <group string="Last Platform Push"
                 invisible="presaleiq_push_status == ''">
            <field name="presaleiq_push_status"        readonly="1"/>
            <field name="presaleiq_push_stories_count" readonly="1"/>
          </group>

          <!-- Empty state — shown when no analysis exists yet -->
          <div class="o_form_sheet_bg mt-3"
               invisible="presaleiq_analysis_url != False">
            <p class="text-muted">
              No analysis yet. Click <strong>Analyze with PresaleIQ</strong> above
              to generate a SOW, User Stories, and Effort Estimate for this Sales Order.<br/>
              For licence sizing: click <strong>Get Questionnaire</strong> in the
              Licence Sizing section, send the blank DOCX to your customer, attach
              their completed version here, then click <strong>Run License Sizing</strong>.
            </p>
          </div>

        </page>
      </xpath>
    </field>
  </record>

</odoo>
