<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Opportunity form: PresaleIQ button + smart button ───────────────── -->
  <record id="crm_lead_view_form_presaleiq" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_all_leads"/>
    <field name="arch" type="xml">

      <!-- Smart button (top-right pill) -->
      <div name="button_box" position="inside">
        <button name="action_open_presaleiq"
                type="object"
                class="oe_stat_button"
                icon="fa-robot"
                attrs="{'invisible': [('presaleiq_analysis_url', '=', False)]}">
          <div class="o_stat_info">
            <span class="o_stat_text">PresaleIQ</span>
            <span class="o_stat_value">
              <field name="presaleiq_story_count"/> stories
            </span>
          </div>
        </button>
      </div>

      <!-- "Analyze with PresaleIQ" action button in the header -->
      <div name="button_box" position="before">
        <button name="action_analyze_with_presaleiq"
                type="object"
                string="Analyze with PresaleIQ"
                class="btn btn-primary"
                icon="fa-magic"/>
      </div>

    </field>
  </record>

  <!-- ── PresaleIQ fields tab in opportunity form ─────────────────────────── -->
  <record id="crm_lead_view_form_presaleiq_tab" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq.tab</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_all_leads"/>
    <field name="arch" type="xml">
      <page name="notes" position="after">
        <page name="presaleiq" string="PresaleIQ">
          <group string="AI Analysis">
            <field name="presaleiq_last_analyzed" readonly="1"/>
            <field name="presaleiq_story_count" readonly="1"/>
            <field name="presaleiq_status" readonly="1"/>
            <field name="presaleiq_analysis_url" widget="url" readonly="1"/>
          </group>
          <div class="mt-2" attrs="{'invisible': [('presaleiq_analysis_id', '=', 0)]}">
            <button name="action_refresh_presaleiq_status"
                    type="object"
                    string="Refresh Status"
                    class="btn btn-secondary btn-sm"
                    icon="fa-refresh"/>
          </div>
          <div class="o_form_sheet_bg mt-3" attrs="{'invisible': [('presaleiq_analysis_url', '!=', False)]}">
            <p class="text-muted">
              No analysis yet. Click <strong>Analyze with PresaleIQ</strong> above
              to generate a SOW, User Stories, and Effort Estimate for this opportunity.
            </p>
          </div>
        </page>
      </page>
    </field>
  </record>

</odoo>
