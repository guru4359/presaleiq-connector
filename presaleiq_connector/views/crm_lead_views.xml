<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Opportunity form: action buttons + smart button ─────────────────── -->
  <record id="crm_lead_view_form_presaleiq" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_all_leads"/>
    <field name="arch" type="xml">

      <!-- Smart button (top-right pill) — shows story count -->
      <div name="button_box" position="inside">
        <button name="action_open_presaleiq"
                type="object"
                class="oe_stat_button"
                icon="fa-robot"
                attrs="{'invisible': [('presaleiq_analysis_url', '=', False)]}">
          <div class="o_stat_info">
            <span class="o_stat_text">PresaleIQ</span>
            <span class="o_stat_value">
              <field name="presaleiq_story_count"/> stories
            </span>
          </div>
        </button>

        <!-- Live Agent smart button -->
        <button name="action_open_live_agent_dashboard"
                type="object"
                class="oe_stat_button"
                icon="fa-microphone"
                attrs="{'invisible': [('presaleiq_session_url', '=', False)]}">
          <div class="o_stat_info">
            <span class="o_stat_text">Live Agent</span>
            <span class="o_stat_value">Dashboard</span>
          </div>
        </button>
      </div>

      <!-- Primary action buttons in the form header -->
      <div name="button_box" position="before">
        <button name="action_analyze_with_presaleiq"
                type="object"
                string="Analyze with PresaleIQ"
                class="btn btn-primary"
                icon="fa-magic"/>
        <button name="action_license_sizing_presaleiq"
                type="object"
                string="License Sizing"
                class="btn btn-secondary"
                icon="fa-calculator"/>
        <button name="action_start_live_agent_presaleiq"
                type="object"
                string="Live Agent"
                class="btn btn-secondary"
                icon="fa-microphone"/>
        <button name="action_push_to_platform_presaleiq"
                type="object"
                string="Push to Platform"
                class="btn btn-secondary"
                icon="fa-upload"
                attrs="{'invisible': [('presaleiq_status', '!=', 'complete')]}"/>
      </div>

    </field>
  </record>

  <!-- ── PresaleIQ tab in opportunity form ───────────────────────────────── -->
  <record id="crm_lead_view_form_presaleiq_tab" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq.tab</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_all_leads"/>
    <field name="arch" type="xml">
      <page name="notes" position="after">
        <page name="presaleiq" string="PresaleIQ">

          <!-- AI Analysis section -->
          <group string="AI Analysis — SOW + User Stories">
            <field name="presaleiq_last_analyzed" readonly="1"/>
            <field name="presaleiq_story_count"   readonly="1"/>
            <field name="presaleiq_status"         readonly="1"/>
            <field name="presaleiq_analysis_url"   widget="url" readonly="1"/>
          </group>
          <div class="mt-2 mb-3"
               attrs="{'invisible': [('presaleiq_analysis_id', '=', 0)]}">
            <button name="action_refresh_presaleiq_status"
                    type="object"
                    string="Refresh Status"
                    class="btn btn-secondary btn-sm"
                    icon="fa-refresh"/>
            <button name="action_push_to_platform_presaleiq"
                    type="object"
                    string="Push to Platform"
                    class="btn btn-primary btn-sm ms-2"
                    icon="fa-upload"
                    attrs="{'invisible': [('presaleiq_status', '!=', 'complete')]}"/>
          </div>

          <!-- License Sizing section -->
          <group string="License Sizing"
                 attrs="{'invisible': [('presaleiq_license_analysis_id', '=', 0)]}">
            <field name="presaleiq_license_status" readonly="1"/>
            <field name="presaleiq_license_url"    widget="url" readonly="1"/>
          </group>

          <!-- Live Agent section -->
          <group string="Live Agent"
                 attrs="{'invisible': [('presaleiq_session_id', '=', 0)]}">
            <field name="presaleiq_session_url" widget="url" readonly="1"/>
          </group>

          <!-- Last Push section -->
          <group string="Last Platform Push"
                 attrs="{'invisible': [('presaleiq_push_status', '=', '')]}">
            <field name="presaleiq_push_status"        readonly="1"/>
            <field name="presaleiq_push_stories_count" readonly="1"/>
          </group>

          <!-- Empty state -->
          <div class="o_form_sheet_bg mt-3"
               attrs="{'invisible': [('presaleiq_analysis_url', '!=', False)]}">
            <p class="text-muted">
              No analysis yet. Click Analyze with PresaleIQ above
              to generate a SOW, User Stories, and Effort Estimate.
              Use License Sizing to get platform license recommendations.
              Use Live Agent to send an AI bot to your next discovery call.
            </p>
          </div>

        </page>
      </page>
    </field>
  </record>

</odoo>
