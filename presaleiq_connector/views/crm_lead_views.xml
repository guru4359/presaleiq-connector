<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Opportunity form: action buttons + smart buttons ───────────────── -->
  <record id="crm_lead_view_form_presaleiq" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq</field>
    <field name="model">crm.lead</field>
    <!-- FIX: crm_lead_view_form is the opportunity form (crm_lead_all_leads is a list view) -->
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">

      <!-- Smart buttons (top-right pill area) -->
      <div name="button_box" position="inside">
        <button name="action_open_presaleiq"
                type="object"
                class="oe_stat_button"
                icon="fa-robot"
                invisible="not presaleiq_analysis_url">
          <!-- FIX: replaced deprecated attrs with inline invisible (Odoo 17) -->
          <div class="o_stat_info">
            <span class="o_stat_text">PresaleIQ</span>
            <span class="o_stat_value">
              <field name="presaleiq_story_count"/> stories
            </span>
          </div>
        </button>

        <button name="action_open_live_agent_dashboard"
                type="object"
                class="oe_stat_button"
                icon="fa-microphone"
                invisible="not presaleiq_session_url">
          <div class="o_stat_info">
            <span class="o_stat_text">Live Agent</span>
            <span class="o_stat_value">Dashboard</span>
          </div>
        </button>
      </div>

      <!-- Primary action buttons — FIX: target <header>, not button_box -->
      <header position="inside">
        <button name="action_analyze_with_presaleiq"
                type="object"
                string="Analyze with PresaleIQ"
                class="btn btn-primary"
                icon="fa-magic"/>
        <button name="action_license_sizing_presaleiq"
                type="object"
                string="License Sizing"
                class="btn btn-secondary"
                icon="fa-calculator"/>
        <button name="action_start_live_agent_presaleiq"
                type="object"
                string="Live Agent"
                class="btn btn-secondary"
                icon="fa-microphone"/>
        <button name="action_push_to_platform_presaleiq"
                type="object"
                string="Push to Platform"
                class="btn btn-secondary"
                icon="fa-upload"
                invisible="presaleiq_status != 'complete'"/>
      </header>

    </field>
  </record>

  <!-- ── PresaleIQ tab in opportunity form ───────────────────────────────── -->
  <record id="crm_lead_view_form_presaleiq_tab" model="ir.ui.view">
    <field name="name">crm.lead.view.form.presaleiq.tab</field>
    <field name="model">crm.lead</field>
    <!-- FIX: same inherit_id correction -->
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <page name="notes" position="after">
        <page name="presaleiq" string="PresaleIQ">

          <!-- AI Analysis section -->
          <group string="AI Analysis — SOW + User Stories">
            <field name="presaleiq_last_analyzed" readonly="1"/>
            <field name="presaleiq_story_count"   readonly="1"/>
            <field name="presaleiq_status"         readonly="1"/>
            <field name="presaleiq_analysis_url"   widget="url" readonly="1"/>
          </group>
          <!-- FIX: inline invisible replaces attrs -->
          <div class="mt-2 mb-3" invisible="presaleiq_analysis_id == 0">
            <button name="action_refresh_presaleiq_status"
                    type="object"
                    string="Refresh Status"
                    class="btn btn-secondary btn-sm"
                    icon="fa-refresh"/>
            <button name="action_push_to_platform_presaleiq"
                    type="object"
                    string="Push to Platform"
                    class="btn btn-primary btn-sm ms-2"
                    icon="fa-upload"
                    invisible="presaleiq_status != 'complete'"/>
          </div>

          <!-- License Sizing section -->
          <group string="License Sizing"
                 invisible="presaleiq_license_analysis_id == 0">
            <field name="presaleiq_license_status" readonly="1"/>
            <field name="presaleiq_license_url"    widget="url" readonly="1"/>
          </group>

          <!-- Live Agent section -->
          <group string="Live Agent"
                 invisible="presaleiq_session_id == 0">
            <field name="presaleiq_session_url" widget="url" readonly="1"/>
          </group>

          <!-- Last Push section -->
          <group string="Last Platform Push"
                 invisible="presaleiq_push_status == ''">
            <field name="presaleiq_push_status"        readonly="1"/>
            <field name="presaleiq_push_stories_count" readonly="1"/>
          </group>

          <!-- Empty state — shown when no analysis exists yet -->
          <div class="o_form_sheet_bg mt-3"
               invisible="presaleiq_analysis_url != False">
            <p class="text-muted">
              No analysis yet. Click <strong>Analyze with PresaleIQ</strong> above
              to generate a SOW, User Stories, and Effort Estimate.<br/>
              Use <strong>License Sizing</strong> to get platform license
              recommendations.<br/>
              Use <strong>Live Agent</strong> to send an AI bot to your next
              discovery call.
            </p>
          </div>

        </page>
      </page>
    </field>
  </record>

</odoo>
